{
  "name": "vora-concrete-living",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr scripts/prerender-entry.jsx --outDir .prerender --emptyOutDir && node scripts/postbuild-seo.mjs",
    "preview": "vite preview",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "npm run test:data && npm run test:finder && npm run test:configuration && npm run test:analytics && npm run test:api && npm run test:e2e",
    "test:data": "node --test tests/houses-data.test.js",
    "test:finder": "node --test tests/model-finder.test.js",
    "test:configuration": "node --test tests/configuration.test.js",
    "test:analytics": "node --test tests/analytics.test.js",
    "validate:data": "node scripts/validate-houses.mjs",
    "validate:content": "node scripts/validate-business-content.mjs",
    "test:api": "node --test tests/api-contact.test.js tests/lead-record.test.js",
    "test:e2e": "playwright test",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:performance": "node scripts/validate-performance.mjs",
    "check": "npm run build && npm run validate:seo && npm run validate:performance && npm run validate:content && npm test"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^8.3.0"
  }
}
